---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

// Get all garden notes
const notes = await getCollection("garden");
const sortedNotes = notes.sort((a, b) => {
  const dateA = a.data.date ? new Date(a.data.date) : new Date(0);
  const dateB = b.data.date ? new Date(b.data.date) : new Date(0);
  return dateB.getTime() - dateA.getTime();
});
---

<BaseLayout title="Digital Garden">
  <!-- GARDEN HEADER -->
  <div class="mb-16 pt-10 animate-fade-in">
    <div class="font-mono text-xs text-secondary mb-6 tracking-wider">
      /// DIGITAL_GARDEN
    </div>
    <h1 class="font-serif text-5xl mb-4 text-primary">The Garden</h1>
    <p class="text-secondary text-lg max-w-xl leading-relaxed mb-8">
      A collection of raw notes, half-baked ideas, and reference sheets. Unlike
      projects, these are never "finished."
    </p>

    <!-- SEARCH AND FILTER CONTROLS -->
    <div class="flex flex-col md:flex-row gap-4 items-start md:items-center">
      <div class="relative w-full md:w-96 group">
        <div
          class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none"
        >
          <svg
            class="w-5 h-5 text-secondary group-focus-within:text-primary transition-colors"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>
        <input
          type="text"
          id="search-input"
          placeholder="Search notes..."
          class="block w-full pl-10 pr-3 py-2 bg-surface border border-border rounded-lg leading-5 text-primary placeholder-secondary focus:outline-none focus:border-secondary focus:ring-1 focus:ring-secondary sm:text-sm transition-all"
        />
      </div>

      <div
        id="active-filters"
        class="hidden flex items-center gap-2 animate-fade-in"
      >
        <span class="text-xs text-secondary uppercase tracking-wider"
          >Filtered by:</span
        >
        <button
          id="clear-filters"
          class="text-xs font-mono text-primary bg-surface border border-border px-2 py-1 rounded hover:bg-surface-hover transition-colors flex items-center gap-1"
        >
          <span id="filter-label">TAG</span>
          <svg
            class="w-3 h-3"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path></svg
          >
        </button>
      </div>
    </div>
  </div>

  <!-- THE GRID OF BOXES -->
  <div
    id="notes-grid"
    class="grid grid-cols-1 md:grid-cols-2 gap-6 animate-slide-up"
    style="animation-delay: 0.1s;"
  >
    {
      sortedNotes.map((note) => {
        // Determine status style
        const status = note.data.status || "Seedling";
        let statusColor = "text-green-500 border-green-500/30 bg-green-500/10";
        let statusIcon = "🌱";

        if (
          status.toLowerCase().includes("budding") ||
          status.toLowerCase().includes("growing")
        ) {
          statusColor = "text-yellow-500 border-yellow-500/30 bg-yellow-500/10";
          statusIcon = "🌿";
        } else if (
          status.toLowerCase().includes("evergreen") ||
          status.toLowerCase().includes("active")
        ) {
          statusColor =
            "text-emerald-500 border-emerald-500/30 bg-emerald-500/10";
          statusIcon = "🌳";
        }

        return (
          <article
            class="note-card group block bg-surface border border-border rounded-2xl p-8 hover:-translate-y-1 hover:border-secondary hover:bg-surface-hover transition-all duration-200 cursor-pointer"
            data-title={note.data.title.toLowerCase()}
            data-description={note.data.description.toLowerCase()}
            data-tags={note.data.tags?.join(",").toLowerCase() || ""}
          >
            <a
              href={`/anxiety_porfolio/garden/${note.slug}`}
              class="block h-full"
            >
              <div class="flex justify-between mb-4 items-start">
                <span
                  class={`font-mono text-[10px] uppercase border px-2 py-1 rounded-full flex items-center gap-1 ${statusColor}`}
                >
                  <span>{statusIcon}</span>
                  {status}
                </span>
                <span class="font-mono text-xs text-secondary">
                  {new Date(note.data.date).toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "short",
                    day: "numeric",
                  })}
                </span>
              </div>

              <h3 class="font-serif text-2xl mb-3 text-primary group-hover:text-accent transition-colors">
                {note.data.title}
              </h3>
              <p class="text-secondary text-sm mb-6 leading-relaxed line-clamp-3">
                {note.data.description}
              </p>

              <div class="flex flex-wrap gap-2 font-mono text-xs text-secondary opacity-70 group-hover:opacity-100 transition-opacity">
                {note.data.tags?.map((tag) => (
                  <button
                    class="tag-btn hover:text-primary hover:underline z-10 relative"
                    data-tag={tag.toLowerCase()}
                    onclick="event.preventDefault();"
                  >
                    #{tag}
                  </button>
                ))}
              </div>
            </a>
          </article>
        );
      })
    }
  </div>

  <!-- EMPTY STATE -->
  <div id="empty-state" class="hidden text-center py-20 animate-fade-in">
    <div class="text-6xl mb-4">🏜️</div>
    <h3 class="font-serif text-2xl text-primary mb-2">No notes found</h3>
    <p class="text-secondary">Try adjusting your search or filters.</p>
    <button
      id="reset-search"
      class="mt-4 text-sm font-mono text-primary border-b border-primary hover:border-transparent transition-all"
    >
      Clear all filters
    </button>
  </div>

  <script>
    // Client-side search and filtering
    const searchInput = document.getElementById(
      "search-input",
    ) as HTMLInputElement;
    const notesGrid = document.getElementById("notes-grid");
    const emptyState = document.getElementById("empty-state");
    const noteCards = document.querySelectorAll(".note-card");
    const tagButtons = document.querySelectorAll(".tag-btn");
    const activeFilters = document.getElementById("active-filters");
    const clearFiltersBtn = document.getElementById("clear-filters");
    const filterLabel = document.getElementById("filter-label");
    const resetSearchBtn = document.getElementById("reset-search");

    let currentTagFilter: string | null = null;

    function filterNotes() {
      if (!searchInput) return;
      const searchTerm = searchInput.value.toLowerCase();
      let visibleCount = 0;

      noteCards.forEach((card) => {
        const htmlCard = card as HTMLElement;
        const title = htmlCard.dataset.title || "";
        const description = htmlCard.dataset.description || "";
        const tags = htmlCard.dataset.tags || "";

        const matchesSearch =
          title.includes(searchTerm) ||
          description.includes(searchTerm) ||
          tags.includes(searchTerm);
        const matchesTag = currentTagFilter
          ? tags.includes(currentTagFilter)
          : true;

        if (matchesSearch && matchesTag) {
          htmlCard.style.display = "block";
          visibleCount++;
        } else {
          htmlCard.style.display = "none";
        }
      });

      // Toggle empty state
      if (visibleCount === 0) {
        notesGrid?.classList.add("hidden");
        emptyState?.classList.remove("hidden");
      } else {
        notesGrid?.classList.remove("hidden");
        emptyState?.classList.add("hidden");
      }

      // Update filter UI
      if (currentTagFilter) {
        activeFilters?.classList.remove("hidden");
        if (filterLabel)
          filterLabel.textContent = `#${currentTagFilter.toUpperCase()}`;
      } else {
        activeFilters?.classList.add("hidden");
      }
    }

    // Event Listeners
    searchInput?.addEventListener("input", filterNotes);

    tagButtons.forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation(); // Prevent card click
        const target = e.target as HTMLElement;
        currentTagFilter = target.dataset.tag || null;
        if (searchInput) searchInput.value = ""; // Optional: clear search when tag clicked
        filterNotes();
      });
    });

    clearFiltersBtn?.addEventListener("click", () => {
      currentTagFilter = null;
      filterNotes();
    });

    resetSearchBtn?.addEventListener("click", () => {
      currentTagFilter = null;
      if (searchInput) searchInput.value = "";
      filterNotes();
    });
  </script>
</BaseLayout>
